---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Experience from "../components/Experience.astro";
import { skills, education, achievements, openSource } from "../data/profile";

const description =
  "About Md. Akib Hossain Omi: software engineer at Telcobright, co-founder of Intech Solution, CSE graduate of Daffodil Institute of IT and competitive programmer from Narayanganj, Bangladesh.";
---

<Base title="About" description={description}>
  <div class="mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-8 sm:pt-20">
    <p class="label">About</p>
    <h1 class="mt-4 max-w-3xl font-serif text-[clamp(2.4rem,7vw,4.5rem)] leading-[1]">
      Engineer at Telcobright, co-founder at Intech Solution.
    </h1>
    <div class="prose-body mt-8 grid gap-8 text-ink-2 md:grid-cols-2 md:gap-12">
      <div>
        <p>
          I'm Akib, from <span class="text-ink">Narayanganj, Bangladesh</span>. I finished my B.Sc. in Computer Science
          and Engineering at Daffodil Institute of IT, and since July 2023 I've been a software engineer
          at <span class="text-ink">Telcobright</span>, working on the billing and reporting side of a telecom platform.
        </p>
        <p>
          I also co-founded <a href="https://intechsolution.bd" target="_blank" rel="noopener" class="link text-ink">Intech Solution</a>,
          where we build <a href="/projects#quicksell" class="link text-ink">QuickSell</a> for shops that run their business
          inside chat apps.
        </p>
      </div>
      <div>
        <p>
          Competitive programming is how I learned, and I still like a hard problem. I was president of the DIIT
          Programming Club for a year, writing problem sets and coaching teams for regional contests.
        </p>
        <p>
          Away from the keyboard I play games, read, and travel whenever there's a chance.
        </p>
      </div>
    </div>
  </div>

  <Section id="experience" label="01" title="Experience">
    <Experience />
  </Section>

  <Section id="skills" label="02" title="What I work with" class="mt-20">
    <dl class="grid gap-6 sm:grid-cols-2">
      {skills.map((s) => (
        <div>
          <dt class="label">{s.group}</dt>
          <dd class="mt-2 text-lg leading-relaxed">{s.items.join(", ")}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="recognition" label="03" title="Contests & open source" class="mt-20">
    <div class="grid gap-10 md:grid-cols-2">
      <ul class="space-y-4">
        {achievements.map((a) => (
          <li>
            <p class="font-medium">{a.title}</p>
            <p class="text-ink-2">{a.detail}</p>
          </li>
        ))}
      </ul>
      <ul class="space-y-4">
        {openSource.map((o) => (
          <li>
            <p class="font-medium"><a href={o.href} target="_blank" rel="noopener" class="link">{o.project}</a> <span class="font-mono text-xs text-muted">{o.stack}</span></p>
            <p class="text-ink-2">{o.detail}</p>
          </li>
        ))}
        <li>
          <p class="font-medium">Education</p>
          <p class="text-ink-2">{education.degree}, {education.school} ({education.period}, {education.note})</p>
        </li>
      </ul>
    </div>
  </Section>
</Base>
