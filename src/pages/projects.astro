---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects, otherProjects } from "../data/projects";

const description =
  "Projects by Md. Akib Hossain Omi, including QuickSell, an AI sales inbox for Facebook, Instagram and WhatsApp shops, Distressed Pro Data, ResultSync and EcoSync.";
---

<Base title="Projects" description={description}>
  <div class="mx-auto max-w-5xl px-5 pb-14 pt-12 sm:px-8 sm:pt-20">
    <p class="label">Projects</p>
    <h1 class="mt-4 max-w-3xl font-serif text-[clamp(2.4rem,7vw,4.5rem)] leading-[1]">
      Things I've built and shipped
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-2">
      Two products that are live with real customers, followed by earlier work from university, hackathons and side projects.
      The live products are closed source; the rest are on GitHub.
    </p>
  </div>

  <Section id="live" label="In production">
    <div class="space-y-20 md:space-y-28">
      {featuredProjects.map((p, i) => <FeaturedProject project={p} index={i} eager={i === 0} headingLevel="h2" />)}
    </div>
  </Section>

  <Section id="earlier" label="Earlier work" class="mt-24">
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {otherProjects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>
</Base>
