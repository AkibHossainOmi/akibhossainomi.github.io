---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const description =
  "Projects by Md. Akib Hossain Omi, including ResultSync, EcoSync, Health, FamilyCart and FontForger.";
---

<Base title="Projects" description={description}>
  <div class="mx-auto max-w-5xl px-5 pb-14 pt-12 sm:px-8 sm:pt-20">
    <p class="label">Projects</p>
    <h1 class="mt-4 max-w-3xl font-serif text-[clamp(2.4rem,7vw,4.5rem)] leading-[1]">
      Things I've built and shipped
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-2">
      Work from university, hackathons and side projects. The source for each is on GitHub.
    </p>
  </div>

  <section class="mx-auto max-w-5xl px-5 sm:px-8" aria-label="Projects">
    <div class="grid gap-x-8 gap-y-14 border-t border-ink pt-10 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
