---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <p class="label">404</p>
    <h1 class="mt-4 font-semibold tracking-[-0.035em] text-4xl leading-none sm:text-6xl">Nothing here.</h1>
    <p class="mt-6 max-w-md text-lg text-ink-2">
      The page may have moved when this site was rebuilt. Try one of these instead:
    </p>
    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-lg">
      <li><a href="/" class="link">Home</a></li>
      <li><a href="/about" class="link">About</a></li>
      <li><a href="/projects" class="link">Projects</a></li>
      <li><a href="/resume" class="link">Resume</a></li>
    </ul>
  </div>
</Base>
