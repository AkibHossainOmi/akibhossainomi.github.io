---
import Base from "../layouts/Base.astro";
import Experience from "../components/Experience.astro";
import { site } from "../data/site";
import { skills, education, achievements, openSource } from "../data/profile";
import { projects } from "../data/projects";

const description =
  "Resume of Md. Akib Hossain Omi: software engineer at Telcobright, co-founder of Intech Solution, B.Sc. in CSE. Experience, skills, projects and awards, with a PDF download.";
---

<Base title="Resume" description={description}>
  <div class="mx-auto max-w-3xl px-5 pt-12 sm:px-8 sm:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-ink pb-6">
      <div>
        <p class="label">Resume</p>
        <h1 class="mt-3 font-semibold tracking-[-0.035em] text-4xl leading-none sm:text-5xl">{site.name}</h1>
        <p class="mt-3 text-ink-2">{site.role} · {site.location.city}, {site.location.country}</p>
        <p class="mt-1 font-mono text-sm">
          <a href={`mailto:${site.email}`} class="link break-all">{site.email}</a>
        </p>
      </div>
      <a href={site.resumePdf} download class="inline-flex items-center gap-2 rounded bg-ink px-4 py-2.5 text-paper transition-colors hover:bg-accent hover:text-accent-ink">
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </div>

    <section class="mt-10" aria-labelledby="r-exp">
      <h2 id="r-exp" class="label mb-5">Experience</h2>
      <Experience />
    </section>

    <section class="mt-12" aria-labelledby="r-proj">
      <h2 id="r-proj" class="label mb-5">Projects</h2>
      <ul class="space-y-4">
        {projects.map((p) => (
          <li class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <p class="font-medium">
              <a href={p.live ?? p.source} target="_blank" rel="noopener" class="link">{p.title}</a>
            </p>
            <div>
              <p class="text-ink-2">{p.summary}</p>
              <p class="font-mono text-[0.72rem] text-muted">{p.tags.join(" · ")}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="r-skills">
      <h2 id="r-skills" class="label mb-5">Skills</h2>
      <dl class="space-y-2">
        {skills.map((s) => (
          <div class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <dt class="text-muted">{s.group}</dt>
            <dd>{s.items.join(", ")}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="r-edu">
      <h2 id="r-edu" class="label mb-5">Education</h2>
      <div class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-8">
        <p class="font-mono text-[0.8rem] text-muted sm:pt-1">{education.period}</p>
        <div>
          <p class="font-medium">{education.degree}</p>
          <p class="text-ink-2">{education.school} · {education.note}</p>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="r-awards">
      <h2 id="r-awards" class="label mb-5">Awards & open source</h2>
      <ul class="space-y-2">
        {achievements.map((a) => <li><span class="font-medium">{a.title}:</span> <span class="text-ink-2">{a.detail}</span></li>)}
        {openSource.map((o) => <li><span class="font-medium">{o.project} ({o.stack}):</span> <span class="text-ink-2">{o.detail}</span></li>)}
      </ul>
    </section>
  </div>
</Base>
