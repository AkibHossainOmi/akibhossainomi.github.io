---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props { project: Project }
const { project: p } = Astro.props;
const primary = p.live ?? p.source;
---

<article id={p.slug} class="group flex scroll-mt-24 flex-col">
  <a href={primary} target="_blank" rel="noopener" class="block overflow-hidden rounded-md border border-line bg-paper-2" tabindex="-1" aria-hidden="true">
    <Image
      src={p.image}
      alt=""
      widths={[400, 640]}
      sizes="(min-width: 640px) 320px, 100vw"
      loading="lazy"
      class="aspect-[16/10] w-full object-cover grayscale-[35%] transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
    />
  </a>
  <div class="mt-4 flex items-baseline justify-between gap-3">
    <h3 class="font-semibold tracking-[-0.035em] text-[1.35rem] leading-tight">
      <a href={primary} target="_blank" rel="noopener" class="hover:text-accent">{p.title}</a>
    </h3>
    {p.context && <span class="label shrink-0">{p.context}</span>}
  </div>
  <p class="mt-1 text-ink">{p.summary}</p>
  <p class="mt-2 text-[0.95rem] text-ink-2">{p.description}</p>
  <p class="mt-3 font-mono text-[0.72rem] text-muted">{p.tags.join(" · ")}</p>
  <div class="mt-3 flex gap-4 text-[0.95rem]">
    {p.live && <a href={p.live} target="_blank" rel="noopener" class="link">Live ↗</a>}
    {p.source && <a href={p.source} target="_blank" rel="noopener" class="link">Source ↗</a>}
  </div>
</article>
