---
interface Props {
  id?: string;
  label: string;
  title?: string;
  class?: string;
}
const { id, label, title, class: className } = Astro.props;
---

<section id={id} class:list={["mx-auto max-w-5xl scroll-mt-20 px-5 sm:px-8", className]} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="flex flex-col gap-1 border-t border-ink pt-3 sm:flex-row sm:items-baseline sm:gap-4">
    <p class="label shrink-0">{label}</p>
    {title && <h2 id={id ? `${id}-title` : undefined} class="font-serif text-3xl leading-tight sm:text-4xl">{title}</h2>}
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
