---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
  /** Load the first image eagerly; it is usually above or near the fold. */
  eager?: boolean;
  headingLevel?: "h2" | "h3";
}
const { project: p, index, eager = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const host = p.live ? new URL(p.live).host : "";
const flip = index % 2 === 1;
---

<article id={p.slug} class="grid scroll-mt-24 items-start gap-6 md:grid-cols-12 md:gap-10">
  <a
    href={p.live}
    target="_blank"
    rel="noopener"
    class:list={["group block md:col-span-7", flip && "md:order-2"]}
  >
    <figure class="overflow-hidden rounded-md border border-line bg-paper-2 shadow-[0_1px_0_var(--line)]">
      <div class="flex items-center gap-2 border-b border-line px-3 py-2">
        <span class="flex gap-1.5" aria-hidden="true">
          <i class="size-2 rounded-full bg-line"></i><i class="size-2 rounded-full bg-line"></i><i class="size-2 rounded-full bg-line"></i>
        </span>
        <span class="truncate font-mono text-[0.7rem] text-muted">{host}</span>
        <span class="ml-auto font-mono text-[0.7rem] text-accent opacity-0 transition-opacity group-hover:opacity-100">visit ↗</span>
      </div>
      <Image
        src={p.image}
        alt={p.imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 560px, 100vw"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015]"
      />
    </figure>
  </a>

  <div class:list={["md:col-span-5 md:pt-2", flip && "md:order-1"]}>
    <p class="label">
      <span class="text-accent">{String(index + 1).padStart(2, "0")}</span>
      {p.role && <span> · {p.role}</span>}
    </p>
    <Heading class="mt-2 font-serif text-4xl leading-none sm:text-5xl">{p.title}</Heading>
    <p class="mt-3 text-lg text-ink">{p.summary}</p>
    <p class="mt-3 text-ink-2">{p.description}</p>
    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[0.75rem] text-muted" aria-label="Highlights">
      {p.tags.map((t) => <li>— {t}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-3">
      {p.live && (
        <a href={p.live} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded bg-ink px-4 py-2.5 text-[0.95rem] text-paper transition-colors hover:bg-accent hover:text-accent-ink">
          Visit {host} <span aria-hidden="true">↗</span>
        </a>
      )}
      {p.source && (
        <a href={p.source} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded border border-line px-4 py-2.5 text-[0.95rem] hover:border-ink">
          Source <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
