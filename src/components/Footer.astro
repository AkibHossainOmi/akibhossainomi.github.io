---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 py-12 sm:px-8 md:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="label">Get in touch</p>
      <p class="mt-3 max-w-md font-semibold tracking-[-0.035em] text-2xl leading-tight sm:text-3xl">
        Have a product to build or a problem worth solving?
      </p>
      <a href={`mailto:${site.email}`} class="link mt-4 inline-block break-all font-mono text-[0.95rem]">{site.email}</a>
    </div>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-2 self-end text-[0.95rem]">
      {site.socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="me noopener" class="link text-ink-2">{s.label}</a>
        </li>
      ))}
      <li><a href={site.resumePdf} class="link text-ink-2">Resume (PDF)</a></li>
    </ul>
  </div>
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div class="flex flex-wrap justify-between gap-2 border-t border-line py-5 font-mono text-xs text-muted">
      <span>© {year} {site.name}</span>
      <span>Narayanganj, Bangladesh</span>
    </div>
  </div>
</footer>
